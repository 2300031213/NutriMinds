# NutriMind AI - Environment Configuration

# Database Configuration:
# - For Neon Serverless PostgreSQL:
#   DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# - For Local SQLite (Default if left empty):
#   DATABASE_URL=sqlite:///./nutrimind.db
# - For MySQL:
#   DATABASE_URL=mysql+pymysql://root:password@localhost:3306/nutrimind_ai
DATABASE_URL=

# JWT Authentication
JWT_SECRET_KEY=nutrimind-super-secret-key-change-this-later
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
